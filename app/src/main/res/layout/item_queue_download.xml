<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="10dp"
    android:paddingEnd="8dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/queueTaskTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_bold"
                android:maxLines="1"
                android:textColor="?attr/colorOnBackground"
                android:textSize="16sp"
                tools:text="Dragon Ball Super: Beerus" />

            <TextView
                android:id="@+id/queueTaskName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.75"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_family"
                android:maxLines="1"
                android:textColor="?attr/colorOnBackground"
                android:textSize="14sp"
                tools:text="Episode 1" />
        </LinearLayout>

        <TextView
            android:id="@+id/queueTaskState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:alpha="0.75"
            android:fontFamily="@font/poppins_bold"
            android:textColor="?attr/colorOnBackground"
            android:textSize="13sp"
            tools:text="19%" />

        <ImageButton
            android:id="@+id/queueTaskMenu"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/download_queue_more"
            android:padding="10dp"
            app:srcCompat="@drawable/ic_round_dots_vertical_24"
            app:tint="?attr/colorOnBackground" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/queueTaskProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="16dp"
        android:max="100"
        app:trackCornerRadius="4dp"
        app:trackThickness="4dp" />
</LinearLayout>
