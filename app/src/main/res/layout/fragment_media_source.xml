<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".media.anime.AnimeWatchFragment">

    <TextView
        android:id="@+id/mediaNotSupported"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_margin="32dp"
        android:fontFamily="@font/poppins_bold"
        android:text="@string/not_supported"
        android:textSize="16sp"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/mediaInfoProgressBar"
        style="?android:attr/progressBarStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="32dp"
        android:indeterminate="true"
        android:visibility="gone"
        tools:visibility="gone" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/mediaSourceSwipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <nox.kiwami.util.BounceRecyclerView
            android:id="@+id/mediaSourceRecycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="128dp"
            tools:itemCount="1"
            tools:listitem="@layout/item_media_source" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <LinearLayout
        android:id="@+id/sourcePill"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_source_pill"
        android:clickable="true"
        android:contentDescription="@string/source"
        android:elevation="6dp"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="16dp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="28dp"
            android:layout_height="28dp">

            <ImageView
                android:id="@+id/sourcePillBadge"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/sourcePillLetter"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/poppins_bold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textColor="#1A0B06"
                android:textSize="13sp" />
        </FrameLayout>

        <TextView
            android:id="@+id/sourcePillName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:fontFamily="@font/poppins_bold"
            android:includeFontPadding="false"
            android:letterSpacing="0.05"
            android:maxLines="1"
            android:maxWidth="150dp"
            android:textAllCaps="true"
            android:textSize="13sp" />

        <nox.kiwami.util.SourceStatusView
            android:id="@+id/sourcePillStatus"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="8dp" />

        <TextView
            android:id="@+id/sourcePillCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:alpha="0.65"
            android:fontFamily="@font/poppins_semi_bold"
            android:includeFontPadding="false"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/ScrollTop"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="64dp"
        app:cardBackgroundColor="?android:colorBackground"
        app:cardCornerRadius="24dp"
        app:contentPadding="12dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:rotation="90"
            app:srcCompat="@drawable/ic_round_arrow_back_ios_new_24"
            app:tint="?attr/colorOnSurface"
            tools:ignore="ContentDescription" />
    </androidx.cardview.widget.CardView>
</FrameLayout>
