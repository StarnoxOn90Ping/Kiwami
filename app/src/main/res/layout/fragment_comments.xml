<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/commentsLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground"
    android:clipChildren="false">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/commentsRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <nox.kiwami.util.BounceRecyclerView
            android:id="@+id/commentsList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:visibility="gone"
            tools:listitem="@layout/item_comments"
            tools:visibility="visible" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <nox.kiwami.util.ShimmerLayout
        android:id="@+id/commentsProgressBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:clipChildren="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include layout="@layout/item_comment_skeleton" />

            <include layout="@layout/item_comment_skeleton" />

            <include layout="@layout/item_comment_skeleton" />

            <include layout="@layout/item_comment_skeleton" />
        </LinearLayout>
    </nox.kiwami.util.ShimmerLayout>

    <ProgressBar
        android:id="@+id/commentBottomRefresh"
        style="?android:attr/progressBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="104dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/commentsOfflineText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="80dp"
            android:layout_height="80dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:src="@drawable/bg_offline_icon_disc" />

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_wifi_off_24"
                app:tint="@color/offline_accent" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="@font/poppins_bold"
            android:text="You’re offline"
            android:textColor="?attr/colorOnBackground"
            android:textSize="18sp"
            tools:ignore="HardcodedText" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:alpha="0.65"
            android:fontFamily="@font/poppins_semi_bold"
            android:gravity="center"
            android:text="Connect to the internet to read and post comments."
            android:textColor="?attr/colorOnBackground"
            android:textSize="13sp"
            tools:ignore="HardcodedText" />

        <LinearLayout
            android:id="@+id/commentsRetry"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_offline_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="26dp"
            android:paddingEnd="26dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_offline_refresh"
                app:tint="#1A1A1A" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/poppins_bold"
                android:text="Try again"
                android:textColor="#1A1A1A"
                android:textSize="14sp"
                tools:ignore="HardcodedText" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/commentsEmptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="76dp"
            android:layout_height="76dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.15"
                android:background="@drawable/bg_comment_pill"
                android:backgroundTint="?attr/colorPrimary" />

            <ImageView
                android:id="@+id/commentsEmptyIcon"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_round_comment_24"
                app:tint="?attr/colorPrimary" />
        </FrameLayout>

        <TextView
            android:id="@+id/commentsEmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/poppins_bold"
            android:gravity="center"
            android:text="No comments yet"
            android:textColor="?attr/colorOnBackground"
            android:textSize="18sp"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/commentsEmptySubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:alpha="0.65"
            android:fontFamily="@font/poppins_semi_bold"
            android:gravity="center"
            android:text="Be the first to start the conversation."
            android:textColor="?attr/colorOnBackground"
            android:textSize="13sp"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/commentsEmptyAction"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_comment_pill"
            android:backgroundTint="#1F808080"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/poppins_bold"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="Try again"
            android:textColor="?attr/colorPrimary"
            android:textSize="13sp"
            android:visibility="gone"
            tools:ignore="HardcodedText" />
    </LinearLayout>

    <nox.kiwami.util.FrostedHeaderLayout
        android:id="@+id/commentsHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/commentsTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/poppins_bold"
                    android:includeFontPadding="false"
                    android:paddingStart="20dp"
                    android:text="Comments"
                    android:textColor="?attr/colorOnBackground"
                    android:textSize="20sp" />

                <ImageView
                    android:id="@+id/openRules"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="12dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/open_rules"
                    android:padding="8dp"
                    app:srcCompat="@drawable/ic_round_info_24"
                    app:tint="?attr/colorOnBackground" />
            </LinearLayout>

            <HorizontalScrollView
                android:id="@+id/commentChipsScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/commentSort"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginEnd="8dp"
                        android:clickable="true"
                        android:contentDescription="@string/sort_by"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="11dp"
                        android:paddingEnd="14dp">

                        <ImageView
                            android:id="@+id/commentSortIcon"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:importantForAccessibility="no"
                            app:srcCompat="@drawable/ic_round_sort_24"
                            app:tint="?attr/colorOnBackground" />

                        <TextView
                            android:id="@+id/commentSortLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFamily="@font/poppins_semi_bold"
                            android:includeFontPadding="false"
                            android:text="Newest"
                            android:textColor="?attr/colorOnBackground"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/commentFilter"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginEnd="8dp"
                        android:clickable="true"
                        android:contentDescription="@string/sort_by"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="11dp"
                        android:paddingEnd="14dp">

                        <ImageView
                            android:id="@+id/commentFilterIcon"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:importantForAccessibility="no"
                            app:srcCompat="@drawable/ic_round_filter_alt_24"
                            app:tint="?attr/colorOnBackground" />

                        <TextView
                            android:id="@+id/commentFilterLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFamily="@font/poppins_semi_bold"
                            android:includeFontPadding="false"
                            android:text="Episode"
                            android:textColor="?attr/colorOnBackground"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/commentCurrentProgress"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/poppins_semi_bold"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textColor="?attr/colorOnBackground"
                        android:textSize="12sp"
                        android:visibility="gone"
                        tools:text="Ep 12"
                        tools:visibility="visible" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>
    </nox.kiwami.util.FrostedHeaderLayout>
</FrameLayout>
