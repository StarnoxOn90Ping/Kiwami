<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/splitGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.58" />

    <FrameLayout
        android:id="@+id/iconContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipChildren="false"
        android:paddingTop="24dp"
        app:layout_constraintBottom_toTopOf="@id/splitGuide"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <nox.kiwami.onboarding.KiwamiMarkView
            android:id="@+id/markView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:id="@+id/trackCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:background="@drawable/bg_onboarding_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/trackPoster"
                android:layout_width="76dp"
                android:layout_height="112dp"
                android:background="@drawable/bg_onboarding_poster"
                android:clipToOutline="true"
                android:importantForAccessibility="no"
                android:outlineProvider="background"
                android:scaleType="centerCrop"
                android:src="@drawable/onb_tile_05" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/kanit_semibold"
                    android:text="@string/onboarding_card_episode"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/kanit_medium"
                    android:text="@string/onboarding_card_airing"
                    android:textColor="@color/onb_accent"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_onboarding_bar"
                    android:orientation="horizontal"
                    android:weightSum="24">

                    <View
                        android:id="@+id/trackFill"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="12"
                        android:background="@drawable/bg_onboarding_bar_fill" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/kanit_light"
                    android:text="@string/onboarding_card_progress"
                    android:textColor="@color/onb_text_dim"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/pageContent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="4dp"
        android:paddingEnd="28dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/splitGuide">

        <TextView
            android:id="@+id/pageEyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_onboarding_triangle"
            android:drawablePadding="8dp"
            android:fontFamily="@font/kanit_medium"
            android:gravity="center_vertical"
            android:letterSpacing="0.22"
            android:textColor="@color/onb_accent"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/pageTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/kanit_semibold"
            android:letterSpacing="-0.02"
            android:lineSpacingMultiplier="0.92"
            android:textColor="#FFFFFF"
            android:textSize="38sp" />

        <TextView
            android:id="@+id/pageDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/kanit_regular"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/onb_text_dim"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/noteCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_onboarding_chip"
            android:drawableStart="@drawable/ic_onboarding_check"
            android:drawablePadding="12dp"
            android:drawableTint="#7CFFB2"
            android:fontFamily="@font/kanit_medium"
            android:gravity="center_vertical"
            android:lineSpacingExtra="2dp"
            android:padding="18dp"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/permissionList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:visibility="gone" />

        <GridLayout
            android:id="@+id/themeGrid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="-6dp"
            android:layout_marginTop="16dp"
            android:columnCount="5"
            android:visibility="gone" />

        <TextView
            android:id="@+id/themeName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/kanit_semibold"
            android:textColor="@color/onb_accent"
            android:textSize="18sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/themeHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/kanit_light"
            android:text="@string/onboarding_themes_hint"
            android:textColor="@color/onb_text_dim"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/statusChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_onboarding_chip"
            android:drawablePadding="8dp"
            android:fontFamily="@font/kanit_medium"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="18dp"
            android:paddingBottom="8dp"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/actionButton"
            android:layout_width="wrap_content"
            android:layout_height="54dp"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/kanit_semibold"
            android:minWidth="220dp"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:visibility="gone"
            app:backgroundTint="#26FFFFFF"
            app:cornerRadius="27dp"
            app:strokeColor="@color/onb_accent"
            app:strokeWidth="1.5dp" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
