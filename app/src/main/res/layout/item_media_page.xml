<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/itemContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.flaviofaria.kenburnsview.KenBurnsView
        android:id="@+id/itemCompactBanner"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        tools:ignore="ContentDescription,ImageContrastCheck"
        tools:srcCompat="@tools:sample/backgrounds/scenic[1]" />

    <ImageView
        android:id="@+id/itemCompactBannerNoKen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        tools:ignore="ContentDescription,ImageContrastCheck"
        tools:srcCompat="@tools:sample/backgrounds/scenic[1]" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/hero_scrim" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:visibility="visible"
        app:srcCompat="@drawable/linear_gradient_bg"
        tools:ignore="ContentDescription,ImageContrastCheck" />

    <LinearLayout
        android:id="@+id/itemCompactTitleContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="40dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/itemCompactTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/poppins_bold"
                        android:maxLines="2"
                        android:textColor="?attr/colorOnBackground"
                        android:textSize="24dp"
                        android:transitionName="mediaTitle"
                        tools:ignore="SpUsage"
                        tools:text="@string/slogan" />

                    <LinearLayout
                        android:id="@+id/itemCompactLogoContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/itemCompactLogo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:adjustViewBounds="true"
                            android:maxHeight="84dp"
                            android:scaleType="fitStart"
                            tools:ignore="ContentDescription" />
                    </LinearLayout>
                </FrameLayout>

                <com.google.android.flexbox.FlexboxLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:alignItems="center"
                    app:flexWrap="wrap">

                    <TextView
                        android:id="@+id/itemCompactStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginEnd="12dp"
                        android:layout_marginBottom="4dp"
                        android:fontFamily="@font/poppins_bold"
                        android:letterSpacing="0.06"
                        android:singleLine="true"
                        android:text="@string/status"
                        android:textAllCaps="true"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="13dp"
                        tools:ignore="SpUsage,TextContrastCheck" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginEnd="12dp"
                        android:layout_marginBottom="4dp"
                        android:baselineAligned="true"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/itemCompactTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="0.85"
                            android:textColor="?attr/colorOnBackground"
                            android:textSize="14dp"
                            tools:ignore="SpUsage"
                            tools:text="9 / 12" />

                        <TextView
                            android:id="@+id/itemTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="0.66"
                            android:singleLine="true"
                            android:text="@string/eps"
                            android:textColor="?attr/colorOnBackground"
                            android:textSize="14dp"
                            tools:ignore="SpUsage" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/itemCompactScoreBG"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="4dp"
                        android:background="@drawable/hero_score_pill"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="4dp">

                        <TextView
                            android:id="@+id/itemCompactScore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_bold"
                            android:textColor="#FFFFFF"
                            android:textSize="13dp"
                            tools:ignore="SpUsage"
                            tools:text="7.7" />

                        <ImageView
                            android:id="@+id/imageView2"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginStart="4dp"
                            app:srcCompat="@drawable/ic_round_star_24"
                            app:tint="?attr/colorPrimary"
                            tools:ignore="ContentDescription" />
                    </LinearLayout>
                </com.google.android.flexbox.FlexboxLayout>
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/itemCompactCoverCard"
                android:layout_width="88dp"
                android:layout_height="128dp"
                android:layout_marginStart="14dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="#26FFFFFF"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/itemCompactCover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    tools:ignore="ContentDescription" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <TextView
            android:id="@+id/itemCompactSynopsis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:alpha="0.8"
            android:ellipsize="end"
            android:fontFamily="@font/poppins_family"
            android:lineSpacingMultiplier="1.1"
            android:maxLines="3"
            android:textColor="?attr/colorOnBackground"
            android:textSize="13dp"
            android:visibility="gone"
            tools:ignore="SpUsage"
            tools:text="Sin Yeong-U, an unlucky man in life and a low-level player in the popular VR game." />

        <com.google.android.flexbox.FlexboxLayout
            android:id="@+id/itemCompactGenreChips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:flexWrap="wrap"
            app:maxLine="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/itemCompactDetails"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:includeFontPadding="false"
                android:paddingTop="10dp"
                android:paddingBottom="8dp"
                android:text="@string/details"
                android:textAllCaps="false"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="15dp"
                app:backgroundTint="?attr/colorPrimary"
                app:cornerRadius="24dp"
                tools:ignore="SpUsage" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/itemCompactAddToList"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:includeFontPadding="false"
                android:paddingTop="10dp"
                android:paddingBottom="8dp"
                android:text="@string/hero_add_to_list"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15dp"
                app:backgroundTint="#B31C1C20"
                app:cornerRadius="24dp"
                app:strokeColor="#26FFFFFF"
                app:strokeWidth="1dp"
                tools:ignore="SpUsage" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
