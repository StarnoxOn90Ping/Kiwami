<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="2dp"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="62dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <FrameLayout
        android:layout_width="42dp"
        android:layout_height="42dp">

        <ImageView
            android:id="@+id/sourceRowBadge"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/sourceRowLetter"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="@font/poppins_bold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textColor="#1A0B06"
            android:textSize="17sp"
            tools:text="A" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/sourceRowName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/poppins_bold"
            android:includeFontPadding="false"
            android:letterSpacing="0.04"
            android:maxLines="1"
            android:textAllCaps="true"
            android:textSize="14sp"
            tools:text="ANIMEGG" />

        <TextView
            android:id="@+id/sourceRowSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:alpha="0.6"
            android:ellipsize="end"
            android:fontFamily="@font/poppins_semi_bold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textSize="11sp"
            tools:ignore="SmallSp"
            tools:text="EN · v1.4.3" />
    </LinearLayout>

    <TextView
        android:id="@+id/sourceRowPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_comment_pill"
        android:backgroundTint="#26808080"
        android:fontFamily="@font/poppins_bold"
        android:includeFontPadding="false"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp"
        android:text="RECENT"
        android:textSize="10sp"
        android:visibility="gone"
        tools:ignore="HardcodedText,SmallSp"
        tools:visibility="visible" />

    <ImageView
        android:id="@+id/sourceRowCheck"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        android:visibility="gone"
        app:srcCompat="@drawable/ic_source_check_24"
        tools:visibility="visible" />
</LinearLayout>
