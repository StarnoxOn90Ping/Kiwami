<?xml version="1.0" encoding="utf-8"?>
<nox.kiwami.util.ShimmerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:background="@drawable/bg_skeleton_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:weightSum="10">

            <View
                android:layout_width="0dp"
                android:layout_height="12dp"
                android:layout_weight="6"
                android:background="@drawable/bg_comment_pill"
                android:backgroundTint="#26808080" />

            <View
                android:layout_width="0dp"
                android:layout_height="10dp"
                android:layout_marginTop="9dp"
                android:layout_weight="4"
                android:background="@drawable/bg_comment_pill"
                android:backgroundTint="#1F808080" />
        </LinearLayout>

        <View
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_skeleton_block" />
    </LinearLayout>
</nox.kiwami.util.ShimmerLayout>
